# ==============================================================================
# ChatSignal Environment Configuration
# ==============================================================================

# Server Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Twitch Integration (Optional for local simulator mode)
# Register your app at: https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here
TWITCH_CHANNEL=your_channel_name
TWITCH_BOT_USERNAME=chatsignal_bot
TWITCH_BOT_OAUTH_TOKEN=oauth:your_oauth_token_here

# AI Engine (OpenAI or Compatible Endpoint)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Simulation & Testing Mode
# When set to true, ChatSignal will generate synthetic Twitch chat traffic
SIMULATOR_ENABLED=true
SIMULATOR_SCENARIO=boss_fight
SIMULATOR_MESSAGE_INTERVAL_MS=1200

# Priority Scoring & Heuristic Weights
WEIGHT_FIRST_TIMER=30
WEIGHT_INTENT=25
WEIGHT_CLUSTER=20
WEIGHT_URGENCY=15
WEIGHT_NOISE_PENALTY=50
MIN_PRIORITY_THRESHOLD=60
